# PikaRelay - nginx example (PHP-FPM). nginx ignores .htaccess files, so these rules are required.
# Adjust server_name, root, the TLS certificate paths and fastcgi_pass for your system.
# For an install in a sub-folder (e.g. /relay), prefix every location below with that folder
# and use "try_files $uri /relay/index.php$is_args$args;".

server {
    listen 443 ssl;
    http2 on;
    server_name relay.example.com;
    root /var/www/pikarelay;

    ssl_certificate     /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;

    # Read uploads are capped at 2 MB by PikaRelay; leave a little headroom.
    client_max_body_size 3m;

    # Private folders and dot-files are never served.
    location ~ ^/(src|config|data|tests|tools|vendor|docs|server-configs|nbproject)(/|$) { return 404; }
    location ~ /\. { return 404; }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Only the front controller runs as PHP.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
    location ~ \.php$ { return 404; }
}

server {
    listen 80;
    server_name relay.example.com;
    return 301 https://$host$request_uri;
}

{
    "name": "pikatimer/pikarelay",
    "description": "Web relay between PikaReader timing units and PikaDownloader clients",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "PikaRelay\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "compat": "phpcs --standard=phpcs.xml",
        "lint": "tools/lint.sh"
    }
}

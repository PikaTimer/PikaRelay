# PikaRelay - Apache configuration (needs AllowOverride All, or at least FileInfo + AuthConfig + Options).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Private folders and files are never served.
    RewriteRule ^(src|config|data|tests|tools|vendor|docs|server-configs|nbproject|\.tools|\.git)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    # Everything that is not an existing file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Only index.php may run as PHP; block repository and tooling files.
<FilesMatch "(^\.|\.(md|sh|xml|json|lock|dist|sqlite|sqlite3|db|txt)$)|^(?!index\.php$).+\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
